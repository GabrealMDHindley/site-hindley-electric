# Copy to .env.local for local dev, or set in Vercel → Project Settings → Environment Variables.

# Go High Level (or any) inbound webhook for contact-form leads. Optional —
# without it, submissions are accepted and logged server-side only.
CRM_WEBHOOK_URL=

# Powers the site's chat widget (components/chat/ChatWidget.tsx →
# app/api/chat/route.ts). Get a key at https://console.anthropic.com/settings/keys.
# Without it, the widget shows a friendly "currently unavailable" state.
ANTHROPIC_API_KEY=
